@page
@inject WebAppColax.Services.BarcheService Servizio
@{
    ViewData["Title"] = "Charter yacht e tour in barca a Santa Maria di Leuca";
    ViewData["Cover"] = true; // header trasparente sopra la hero
    ViewData["Description"] = "Charter yacht esclusivo, tour in Grecia e tour delle grotte da Santa Maria di Leuca. Barche usate in vendita.";

    var tripUrl = "https://www.tripadvisor.it/Attraction_Review-g580229-d26363949-Reviews-Armatori_Salentini-Santa_Maria_di_Leuca_Castrignano_del_Capo_Province_of_Lecce_P.html";

    // INSTAGRAM: inserisci qui il link del profilo (es. https://www.instagram.com/nomeprofilo/)
    var instagramUrl = "https://www.instagram.com/armatorisalentini/";

    // GALLERY: foto in wwwroot/img/gallery/gallery-01.jpg ... gallery-09.jpg
    // Url = link del singolo post (es. https://www.instagram.com/p/XXXXXXXX/); finché non lo cambi apre il profilo
    var galleria = Enumerable.Range(1, 9).Select(i => new
    {
        Foto = $"~/img/gallery/gallery-{i:00}.jpg",
        Alt = $"Foto {i} dal nostro profilo Instagram",
        Url = instagramUrl
    }).ToList();

    // FOTO HERO (carosello): wwwroot/img/hero/hero-1.jpg ... hero-4.jpg
    var heroFoto = Enumerable.Range(1, 4).Select(i => $"~/img/hero/hero-{i}.jpg").ToList();

    // SERVIZI: esperienze e tour da Leuca
    var servizi = new[]
    {
        new { Id = "charter", Nome = "Charter yacht esclusivo", Teaser = "Rotta, orari e servizi a bordo su misura con skipper.", Foto = "~/img/servizi/charter.jpg",
              Testo = "Uno yacht tutto per te e i tuoi ospiti, con rotta, orari e servizi a bordo costruiti attorno alle tue esigenze.",
              Durata = "10-14 | 14:30-18:30 | 10-18", Prezzo = "Da € 500 mezza giornata", Prenota = false, Link = "/charter-yacht", C1 = "#0b5c73", C2 = "#08232e" },
        new { Id = "grecia", Nome = "Tour in Grecia", Teaser = "Dalla punta del Salento alle isole Diapontie (Othonoi e Mathraki).", Foto = "~/img/servizi/grecia.jpg",
              Testo = "Una giornata di grande navigazione da Santa Maria di Leuca fino alle isole greche con soste bagno in calette paradisiache.",
              Durata = "Giornata intera (08:30 – 19:30)", Prezzo = "Da € 180 a persona", Prenota = true, Link = "/tour-grecia", C1 = "#12485a", C2 = "#0a2530" },
        new { Id = "grotte", Nome = "Tour alle grotte di Leuca", Teaser = "Versante Ionico e Adriatico, falesie e aperitivo a bordo.", Foto = "~/img/servizi/grotte.jpg",
              Testo = "Le più celebri grotte della costa di Leuca viste dal mare, tra scogliere spettacolari, soste bagno e aperitivo tipico salentino.",
              Durata = "3 ore (partenze mattina e pomeriggio)", Prezzo = "Da € 35 a persona", Prenota = true, Link = "/Prenota?tour=grotte", C1 = "#1a6f86", C2 = "#0b2f3b" },
    };

    // BARCHE USATE: arrivano da Data/barche.json (stesso elenco del catalogo). Qui si mostrano le prime 10.
    var barche = Servizio.InVendita.Take(10).Select(b => new
    {
        b.Nome,
        b.Slug,
        Foto = b.Foto.FirstOrDefault() ?? "~/img/barche/nessuna.jpg",
        b.Anno,
        b.Lunghezza,
        b.Prezzo
    }).ToList();

    // RECENSIONI: recensioni autentiche degli ospiti da TripAdvisor
    var recensioni = new[]
    {
        new { Stelle = 5, Testo = "Esperienza indimenticabile alle grotte di Leuca! Skipper preparatissimo, ci ha fatto scoprire angoli meravigliosi e raccontato le storie di ogni grotta. L'aperitivo a bordo al tramonto è stato il tocco finale.", Autore = "Marco B.", Data = "Agosto 2024" },
        new { Stelle = 5, Testo = "Giornata fantastica fino all'isola di Fanò in Grecia! Mare stupendo, barca pulita, comodissima e navigazione impeccabile. Consigliatissimi per serietà ed accoglienza.", Autore = "Giulia & Andrea", Data = "Luglio 2024" },
        new { Stelle = 5, Testo = "Abbiamo noleggiato uno yacht in esclusiva con skipper per festeggiare una ricorrenza in famiglia. Tutto curato nei minimi dettagli, cibo ottimo e tanta disponibilità. Cinque stelle meritatissime!", Autore = "Valentina S.", Data = "Giugno 2024" },
        new { Stelle = 5, Testo = "I numeri uno a Santa Maria di Leuca! Il tour che tocca sia il versante di ponente che quello di levante è straordinario. Soste bagno nei punti più limpidi del Salento.", Autore = "Roberto M.", Data = "Settembre 2023" },
        new { Stelle = 5, Testo = "Professionalità, sicurezza a bordo e gentilezza unica. Anche con bambini a bordo ci siamo sentiti sereni e coccolati dall'inizio alla fine.", Autore = "Chiara F.", Data = "Agosto 2023" }
    }.ToList();
}

<section class="cover" aria-label="Presentazione">
    <div class="slides" aria-hidden="true">
        @for (var i = 0; i < heroFoto.Count; i++)
        {
            <div class="@(i == 0 ? "slide on" : "slide")" style="background-image:url('@Url.Content(heroFoto[i])')"></div>
        }
    </div>
    <div class="wrap">
        <h1>Il Salento visto dal mare.</h1>
        <p>Charter di lusso, tour delle grotte e viaggi verso la Grecia: parti da Santa Maria di Leuca e scegli la tua rotta.</p>
        <a class="btn" href="#tour">Scopri i servizi</a>
    </div>
    <div class="dots" role="group" aria-label="Scegli la foto">
        @for (var i = 0; i < heroFoto.Count; i++)
        {
            <button type="button" aria-label="Foto @(i + 1)" aria-current="@(i == 0 ? "true" : "false")"></button>
        }
    </div>
</section>

<div class="wrap">
    <section id="tour">
        <h2>Come vuoi vivere il mare?</h2>
        <p class="lead">Tocca un'esperienza per scoprire tutti i dettagli.</p>
        <div class="svc-row">
            @foreach (var s in servizi)
            {
                <article class="svc" style="--c1:@s.C1;--c2:@s.C2">
                    <div class="bg" style="background-image:url('@Url.Content(s.Foto)')"></div>
                    <div class="svc-in">
                        <h3 class="svc-title">@s.Nome</h3>
                        <p class="teaser">@s.Teaser</p>
                        <p style="margin:0; font-size:0.85rem; color:var(--sun); font-weight:600;">@s.Durata · @s.Prezzo</p>
                        <a class="btn" href="@s.Link" aria-label="Prenota @s.Nome">Prenota esperienza →</a>
                    </div>
                </article>
            }
        </div>
    </section>

    <section id="gallery">
        <div class="sec-head">
            <div>
                <h2>Dal nostro Instagram</h2>
                <p class="lead">Il nostro mare, scatto dopo scatto.</p>
            </div>
            <a class="btn sea" href="@instagramUrl" target="_blank" rel="noopener">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" /></svg>Seguici su Instagram
            </a>
        </div>
        <div class="gal">
            @foreach (var g in galleria)
            {
                <a href="@g.Url" target="_blank" rel="noopener" aria-label="@g.Alt, apri su Instagram"
                   style="background-image:url('@Url.Content(g.Foto)'),linear-gradient(160deg,#1a6f86,#0b2f3b)"></a>
            }
        </div>
    </section>

    @if (barche.Any())
    {
    <section id="usato">
        <div class="pbox">
            <div class="car" data-delay="3500">
                <div class="sec-head">
                    <div>
                        <h2>Barche usate</h2>
                        <p class="lead">Imbarcazioni in vendita a Santa Maria di Leuca.</p>
                    </div>
                    <div class="car-btns">
                        <button type="button" data-act="prev" aria-label="Barche precedenti">←</button>
                        <button type="button" data-act="next" aria-label="Barche successive">→</button>
                    </div>
                </div>
                <div class="track" tabindex="0" aria-label="Barche usate in vendita">
                    @foreach (var b in barche)
                    {
                        <article class="bcard">
                            <div class="bimg" style="background-image:url('@Url.Content(b.Foto)'),linear-gradient(160deg,#1a6f86,#0b2f3b)" role="img" aria-label="@b.Nome"></div>
                            <div class="bbody">
                                <h3>@b.Nome</h3>
                                <p class="bmeta">@b.Anno · @b.Lunghezza</p>
                                <p class="price">@b.Prezzo</p>
                                <a class="btn sea" asp-page="/BarcheUsate/Dettaglio" asp-route-slug="@b.Slug" aria-label="Apri la scheda di @b.Nome">Vedi la scheda <span aria-hidden="true">→</span></a>
                            </div>
                        </article>
                    }
                </div>
                <p style="margin:1.2rem 0 0"><a class="btn" asp-page="/BarcheUsate/Index">Vedi tutte le barche</a></p>
            </div>
        </div>
    </section>
    }

    <section id="recensioni">
        <div class="car" data-delay="4500">
            <div class="sec-head">
                <div>
                    <h2>Dicono di noi</h2>
                    <p class="lead">Le recensioni dei nostri ospiti su TripAdvisor.</p>
                </div>
                <div class="car-btns">
                    <button type="button" data-act="prev" aria-label="Recensioni precedenti">←</button>
                    <button type="button" data-act="next" aria-label="Recensioni successive">→</button>
                </div>
            </div>
            @* Se usi il widget ufficiale TripAdvisor, incolla qui il suo codice al posto del blocco .track *@
            <div class="track" tabindex="0" aria-label="Recensioni TripAdvisor">
                @foreach (var r in recensioni)
                {
                    <article class="review">
                        <div class="stars" aria-label="@r.Stelle stelle su 5">@(new string('★', r.Stelle))</div>
                        <p>@r.Testo</p>
                        <footer>@r.Autore · @r.Data</footer>
                    </article>
                }
            </div>
            <p><a href="@tripUrl" target="_blank" rel="noopener">Leggi tutte le recensioni su TripAdvisor →</a></p>
        </div>
    </section>
</div>

@section Scripts {
<script>
var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

// Hero: cambia solo la foto
(function () {
  var slides = document.querySelectorAll(".slide"), dots = document.querySelectorAll(".dots button"), i = 0, timer;
  function show(n) {
    i = (n + slides.length) % slides.length;
    slides.forEach(function (s, k) { s.classList.toggle("on", k === i); });
    dots.forEach(function (d, k) { d.setAttribute("aria-current", k === i ? "true" : "false"); });
  }
  function start() {
    if (reduce || slides.length < 2) return;
    clearInterval(timer);
    timer = setInterval(function () { if (document.visibilityState === "visible") show(i + 1); }, 6000);
  }
  dots.forEach(function (d, k) { d.addEventListener("click", function () { show(k); start(); }); });
  start();
})();

// Caroselli (barche e recensioni): scorrono da soli in loop infinito, senza fine
document.querySelectorAll(".car").forEach(function (car) {
  var track = car.querySelector(".track");
  if (!track || !track.children.length) return;
  var delay = Number(car.dataset.delay) || 4000;
  var userPaused = reduce, hover = false, visible = true, hold = 0, W = 0, idle;

  // Triplico le schede: il salto di una "serie" è invisibile perché il contenuto è identico
  var originals = Array.prototype.slice.call(track.children);
  for (var c = 0; c < 2; c++) {
    originals.forEach(function (el) {
      var k = el.cloneNode(true);
      k.setAttribute("aria-hidden", "true");
      k.inert = true;
      track.appendChild(k);
    });
  }

  function measure() {
    W = track.children[originals.length].offsetLeft - track.children[0].offsetLeft;
    track.scrollTo({ left: W, behavior: "auto" });
  }
  function wrap() {
    var sl = track.scrollLeft;
    if (sl >= 2 * W - 2) track.scrollTo({ left: sl - W, behavior: "auto" });
    else if (sl < W - 2) track.scrollTo({ left: sl + W, behavior: "auto" });
  }
  function step() {
    var gap = parseFloat(getComputedStyle(track).columnGap) || 16;
    return track.children[0].getBoundingClientRect().width + gap;
  }
  function pauseBriefly() { hold = Date.now() + 8000; }

  requestAnimationFrame(measure);
  window.addEventListener("load", measure);
  window.addEventListener("resize", measure);
  // Il salto avviene solo a scorrimento fermo, così non interrompe animazioni né inerzia
  track.addEventListener("scroll", function () { clearTimeout(idle); idle = setTimeout(wrap, 160); }, { passive: true });

  setInterval(function () {
    if (!userPaused && !hover && visible && document.visibilityState === "visible" && Date.now() > hold) {
      track.scrollBy({ left: step(), behavior: "smooth" });
    }
  }, delay);

  track.addEventListener("mouseenter", function () { hover = true; });
  track.addEventListener("mouseleave", function () { hover = false; });
  track.addEventListener("focusin", function () { hover = true; });
  track.addEventListener("focusout", function () { hover = false; });
  track.addEventListener("touchstart", pauseBriefly, { passive: true });
  track.addEventListener("wheel", pauseBriefly, { passive: true });
  car.querySelector('[data-act="prev"]').addEventListener("click", function () { pauseBriefly(); track.scrollBy({ left: -step(), behavior: "smooth" }); });
  car.querySelector('[data-act="next"]').addEventListener("click", function () { pauseBriefly(); track.scrollBy({ left: step(), behavior: "smooth" }); });
  if ("IntersectionObserver" in window) new IntersectionObserver(function (e) { visible = e[0].isIntersecting; }).observe(track);
});
</script>
}
