@page
@inject WebAppColax.Services.BarcheService Servizio
@{
    ViewData["Title"] = "Esperienze in barca a Santa Maria di Leuca";
    ViewData["Cover"] = true;
    ViewData["Description"] = "Scopri Santa Maria di Leuca dal mare: charter privati, tour delle grotte e giornate in Grecia con partenza dal porto.";

    var tripUrl = "https://www.tripadvisor.it/Attraction_Review-g580229-d26363949-Reviews-Armatori_Salentini-Santa_Maria_di_Leuca_Castrignano_del_Capo_Province_of_Lecce_P.html";
    var instagramUrl = "https://www.instagram.com/armatorisalentini/";
    var heroFoto = Enumerable.Range(1, 4).Select(i => $"~/img/hero/hero-{i}.jpg").ToList();
    var galleria = Enumerable.Range(1, 9).Select(i => new
    {
        Foto = $"~/img/gallery/gallery-{i:00}.jpg",
        Alt = $"Armatori Salentini in navigazione a Santa Maria di Leuca"
    }).ToList();
    var servizi = new[]
    {
        new { Nome = "Charter privato", Teaser = "Una barca tutta per voi, una rotta da scegliere insieme e il tempo di vivere il mare senza fretta.", Foto = "~/img/servizi/charter.jpg", Dettaglio = "DA MEZZA GIORNATA A GIORNATA INTERA", Link = "/charter-yacht", LinkText = "Scopri il charter" },
        new { Nome = "Le grotte di Leuca", Teaser = "La costa vista dall’acqua, tra cavità marine, scogliere chiare e soste per un bagno.", Foto = "~/img/servizi/grotte.jpg", Dettaglio = "COSTA IONICA E ADRIATICA", Link = "/Prenota?tour=grotte", LinkText = "Esplora le grotte" },
        new { Nome = "Una giornata in Grecia", Teaser = "Attraversa lo Ionio verso Othonoi e Mathraki, per una giornata diversa dal solito.", Foto = "~/img/servizi/grecia.jpg", Dettaglio = "ISOLE DIAPONTIE · PARTENZA DA LEUCA", Link = "/tour-grecia", LinkText = "Scopri il tour" }
    };
    var barche = Servizio.InVendita.Take(3).Select(b => new
    {
        b.Nome,
        b.Slug,
        Foto = b.Foto.FirstOrDefault() ?? "~/img/barche/nessuna.jpg",
        b.Anno,
        b.Lunghezza,
        b.Prezzo
    }).ToList();
    var yachtSlides = Servizio.InVendita.Where(b => b.Foto.Any()).Take(5).Select(b => new
    {
        b.Nome,
        Foto = b.Foto.First()
    }).ToList();
    var recensioni = new[]
    {
        new { Stelle = 5, Testo = "Esperienza indimenticabile alle grotte di Leuca! Skipper preparatissimo e aperitivo a bordo al tramonto.", Autore = "Marco B.", Data = "Agosto 2024" },
        new { Stelle = 5, Testo = "Giornata fantastica fino all’isola di Fanò in Grecia! Mare stupendo e navigazione impeccabile.", Autore = "Giulia & Andrea", Data = "Luglio 2024" },
        new { Stelle = 5, Testo = "Tutto curato nei minimi dettagli, cibo ottimo e tanta disponibilità. Cinque stelle meritatissime!", Autore = "Valentina S.", Data = "Giugno 2024" },
        new { Stelle = 5, Testo = "Il tour tocca sia il versante di ponente che quello di levante: soste bagno nei punti più limpidi del Salento.", Autore = "Roberto M.", Data = "Settembre 2023" },
        new { Stelle = 5, Testo = "Professionalità, sicurezza a bordo e gentilezza unica. Ci siamo sentiti sereni e coccolati dall’inizio alla fine.", Autore = "Chiara F.", Data = "Agosto 2023" }
    }.ToList();
    var dataMinima = DateTime.Today.ToString("yyyy-MM-dd");
}

<section class="home-hero" aria-label="Armatori Salentini, esperienze in barca a Leuca">
    <div class="hero-slides" aria-hidden="true">
        @for (var i = 0; i < heroFoto.Count; i++)
        {
            <div class="hero-slide @(i == 0 ? "is-active" : "")" style="background-image:url('@Url.Content(heroFoto[i])')"></div>
        }
    </div>
    <div class="hero-shade" aria-hidden="true"></div>
    <div class="wrap hero-content">
        <p class="eyebrow eyebrow-light">ARMATORI SALENTINI <span>·</span> SANTA MARIA DI LEUCA</p>
        <h1>Il Salento<br />comincia dal mare.</h1>
        <p class="hero-description">Rotte private, grotte e isole da scoprire. Si parte dal porto di Leuca, con chi questo mare lo vive ogni giorno.</p>
        <div class="hero-actions">
            <a class="btn btn-light" href="#esperienze">Esplora le esperienze <span aria-hidden="true">↘</span></a>
            <a class="text-link text-link-light" asp-page="/Contatti">Parla con l’equipaggio <span aria-hidden="true">↗</span></a>
        </div>
    </div>
    <div class="hero-caption"><span>39°48′ N — 18°21′ E</span><span>Il punto più a sud della Puglia</span></div>
    <div class="hero-pagination" role="group" aria-label="Scegli la fotografia di copertina">
        @for (var i = 0; i < heroFoto.Count; i++)
        {
            <button type="button" aria-label="Mostra fotografia @(i + 1)" aria-current="@(i == 0 ? "true" : "false")"></button>
        }
    </div>
</section>

<div class="wrap quick-search-wrap">
    <form class="quick-search" method="get" asp-page="/Prenota" aria-label="Inizia una richiesta di prenotazione">
        <label class="search-field">
            <span>La tua esperienza</span>
            <select name="tour" aria-label="Seleziona un’esperienza">
                <option value="charter">Charter privato</option>
                <option value="grotte">Tour delle grotte</option>
                <option value="grecia">Tour in Grecia</option>
            </select>
        </label>
        <label class="search-field">
            <span>Quando vuoi partire?</span>
            <input type="date" name="data" min="@dataMinima" aria-label="Data preferita" />
        </label>
        <label class="search-field search-guests">
            <span>Ospiti</span>
            <select name="persone" aria-label="Numero di ospiti">
                @for (var persone = 1; persone <= 12; persone++)
                {
                    <option value="@persone" selected="@(persone == 2 ? "selected" : null)">@persone @(persone == 1 ? "ospite" : "ospiti")</option>
                }
            </select>
        </label>
        <button class="btn btn-search" type="submit">Verifica disponibilità <span aria-hidden="true">→</span></button>
    </form>
</div>

<div class="home-page">
    <section class="home-intro section-pad" id="esperienze">
        <div class="wrap">
            <div class="intro-heading">
                <div>
                    <p class="eyebrow">IL MARE, COME PIACE A TE</p>
                    <h2>Ogni rotta ha il suo ritmo.</h2>
                </div>
                <p class="section-description">Una barca tutta per voi, le grotte della costa o una giornata tra le isole greche: si parte da Leuca.</p>
            </div>
            <div class="experience-grid">
                @foreach (var s in servizi)
                {
                    <article class="experience-card">
                        <a class="experience-image" href="@s.Link" aria-label="@s.LinkText: @s.Nome" style="background-image:url('@Url.Content(s.Foto)')">
                        </a>
                        <div class="experience-copy">
                            <p class="eyebrow">@s.Dettaglio</p>
                            <h3>@s.Nome</h3>
                            <p>@s.Teaser</p>
                            <a class="text-link" href="@s.Link">@s.LinkText <span aria-hidden="true">↗</span></a>
                        </div>
                    </article>
                }
            </div>
        </div>
    </section>

    <section class="coast-story" aria-labelledby="coast-title">
        <div class="story-image" role="region" aria-roledescription="carosello" aria-label="Fotografie degli yacht della flotta">
            @for (var i = 0; i < yachtSlides.Count; i++)
            {
                <div class="story-slide @(i == 0 ? "is-active" : "")" role="img" aria-label="@yachtSlides[i].Nome, yacht della flotta Armatori Salentini" aria-hidden="@(i == 0 ? "false" : "true")" style="background-image:url('@Url.Content(yachtSlides[i].Foto)')"></div>
            }
            <span class="image-note">LA FLOTTA, DA VICINO</span>
            @if (yachtSlides.Count > 1)
            {
                <div class="story-carousel-dots" role="group" aria-label="Scegli una fotografia della flotta">
                    @for (var i = 0; i < yachtSlides.Count; i++)
                    {
                        <button type="button" data-yacht-slide="@i" aria-label="Mostra @yachtSlides[i].Nome" aria-current="@(i == 0 ? "true" : "false")"></button>
                    }
                </div>
            }
        </div>
        <div class="story-copy">
            <p class="eyebrow">TRA DUE MARI, UNA SOLA CASA</p>
            <h2 id="coast-title">La costa cambia.<br />Il tempo rallenta.</h2>
            <p>Da una parte lo Ionio, dall’altra l’Adriatico. A bordo, la costa si apre tra grotte, calette e piccoli approdi. Ti accompagniamo a scoprirla con la conoscenza di chi naviga qui da sempre.</p>
            <a class="text-link" asp-page="/Tour/Grecia">Una rotta oltre il Salento <span aria-hidden="true">↗</span></a>
            <div class="story-facts">
                <div><strong>2</strong><span>versanti di costa</span></div>
                <div><strong>1</strong><span>porto di partenza</span></div>
                <div><strong>∞</strong><span>modi di viverla</span></div>
            </div>
        </div>
    </section>

    @if (barche.Any())
    {
        <section class="home-listings section-pad" id="barche">
            <div class="wrap">
                <div class="section-heading">
                    <div>
                        <p class="eyebrow">SELEZIONE ARMATORI SALENTINI</p>
                        <h2>Barche in vendita.</h2>
                        <p class="section-description">Imbarcazioni selezionate dai nostri comandanti, ormeggiate a Santa Maria di Leuca.</p>
                    </div>
                    <a class="text-link" asp-page="/BarcheUsate/Index">Tutto il catalogo <span aria-hidden="true">↗</span></a>
                </div>
                <div class="listing-grid">
                    @foreach (var b in barche)
                    {
                        <article class="listing-card">
                            <a class="listing-image" asp-page="/BarcheUsate/Dettaglio" asp-route-slug="@b.Slug" style="background-image:url('@Url.Content(b.Foto)')" aria-label="Apri @b.Nome">
                                <span>@b.Anno</span>
                            </a>
                            <div class="listing-content">
                                <p class="eyebrow">@b.Lunghezza</p>
                                <h3>@b.Nome</h3>
                                <div class="listing-bottom"><strong>@b.Prezzo</strong><a asp-page="/BarcheUsate/Dettaglio" asp-route-slug="@b.Slug" aria-label="Dettagli @b.Nome">↗</a></div>
                            </div>
                        </article>
                    }
                </div>
            </div>
        </section>
    }

    <section class="home-gallery section-pad" aria-labelledby="gallery-title">
        <div class="wrap">
            <div class="section-heading gallery-heading">
                <div>
                    <p class="eyebrow">APPUNTI DI BORDO</p>
                    <h2 id="gallery-title">La vita, vista dal mare.</h2>
                    <p class="section-description">Il nostro mare, scatto dopo scatto.</p>
                </div>
                <a class="btn btn-outline gallery-cta" href="@instagramUrl" target="_blank" rel="noopener">Seguici su Instagram <span aria-hidden="true">↗</span></a>
            </div>
            <div class="photo-grid">
                @foreach (var g in galleria)
                {
                    <a href="@instagramUrl" target="_blank" rel="noopener" aria-label="@g.Alt, apri Instagram" style="background-image:url('@Url.Content(g.Foto)')"></a>
                }
            </div>
        </div>
    </section>

    <section class="review-section section-pad" id="recensioni">
        <div class="wrap review-panel">
                <div class="review-message">
                <p class="eyebrow">DOPO UNA GIORNATA IN MARE</p>
                <h2>Le storie migliori sono quelle raccontate da voi.</h2>
                <p>Leggi le esperienze degli ospiti sul profilo ufficiale Armatori Salentini.</p>
                <a class="btn btn-outline" href="@tripUrl" target="_blank" rel="noopener noreferrer">Leggi le recensioni <span aria-hidden="true">↗</span></a>
            </div>
            <div class="review-score" aria-label="Valutazione TripAdvisor: 4,9 su 5">
                <span class="score-number">4,9</span><span class="score-outof">/ 5</span>
                <span class="score-stars" aria-hidden="true">★★★★★</span>
                <span class="score-caption">Su TripAdvisor</span>
            </div>
            <div class="review-carousel" aria-label="Recensioni TripAdvisor">
                <p class="eyebrow">RECENSIONI DEGLI OSPITI</p>
                <div class="review-track" aria-live="polite" aria-atomic="true" aria-label="Recensioni degli ospiti">
                    @for (var i = 0; i < recensioni.Count; i++)
                    {
                        var r = recensioni[i];
                        <article class="review-card @(i == 0 ? "is-active" : "")" aria-hidden="@(i == 0 ? "false" : "true")">
                            <span class="review-stars" aria-label="@r.Stelle stelle su 5">@(new string('★', r.Stelle))</span>
                            <p>“@r.Testo”</p>
                            <footer>@r.Autore <span>· @r.Data</span></footer>
                        </article>
                    }
                </div>
            </div>
        </div>
    </section>
</div>

@section Scripts {
<script>
(function () {
  var slides = document.querySelectorAll(".hero-slide");
  var dots = document.querySelectorAll(".hero-pagination button");
  if (slides.length < 2 || !dots.length) return;
  var index = 0;
  var timer;
  var reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  function show(next) {
    index = (next + slides.length) % slides.length;
    slides.forEach(function (slide, i) { slide.classList.toggle("is-active", i === index); });
    dots.forEach(function (dot, i) { dot.setAttribute("aria-current", i === index ? "true" : "false"); });
  }
  function restart() {
    if (reduceMotion) return;
    window.clearInterval(timer);
    timer = window.setInterval(function () {
      if (document.visibilityState === "visible") show(index + 1);
    }, 7000);
  }
  dots.forEach(function (dot, i) { dot.addEventListener("click", function () { show(i); restart(); }); });
  restart();
})();

(function () {
  var container = document.querySelector(".story-image");
  if (!container) return;
  var slides = container.querySelectorAll(".story-slide");
  var buttons = container.querySelectorAll("[data-yacht-slide]");
  if (slides.length < 2 || !buttons.length) return;
  var index = 0;
  var timer;
  var reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  function show(next) {
    index = (next + slides.length) % slides.length;
    slides.forEach(function (slide, i) {
      slide.classList.toggle("is-active", i === index);
      slide.setAttribute("aria-hidden", i === index ? "false" : "true");
    });
    buttons.forEach(function (button, i) { button.setAttribute("aria-current", i === index ? "true" : "false"); });
  }
  function restart() {
    window.clearInterval(timer);
    if (reduceMotion) return;
    timer = window.setInterval(function () {
      if (document.visibilityState === "visible") show(index + 1);
    }, 6500);
  }
  buttons.forEach(function (button) {
    button.addEventListener("click", function () {
      show(Number(button.getAttribute("data-yacht-slide")));
      restart();
    });
  });
  restart();
})();

(function () {
  var slides = document.querySelectorAll(".review-card");
  if (slides.length < 2) return;
  var index = 0;
  var timer;
  var reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  function show(next) {
    index = (next + slides.length) % slides.length;
    slides.forEach(function (slide, i) {
      slide.classList.toggle("is-active", i === index);
      slide.setAttribute("aria-hidden", i === index ? "false" : "true");
    });
  }
  function restart() {
    window.clearInterval(timer);
    if (reduceMotion) return;
    timer = window.setInterval(function () {
      if (document.visibilityState === "visible") show(index + 1);
    }, 6000);
  }
  restart();
})();
</script>
}
